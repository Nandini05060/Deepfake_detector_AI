{
  "metric_definitions_and_denominators": {
    "evaluation_set": "Locked Held-Out Test Set (N = 448: 120 Real + 328 Fake)",
    "formulas": {
      "ROC-AUC": "Area under the Receiver Operating Characteristic curve computed on continuous calibrated fake probabilities P(Fake) across all 448 samples (Denominator: all pairs of positive and negative samples).",
      "PR-AUC": "Area under the Precision-Recall curve computed on continuous calibrated fake probabilities P(Fake) (Denominator: 328 positive samples).",
      "Brier Score": "(1/N) * sum((P(Fake)_i - y_i)^2) for i=1..448, where y_i in {0, 1}. Measures calibrated mean squared probabilistic error (Denominator: N=448).",
      "ECE (10-bin)": "Expected Calibration Error across 10 equally spaced confidence bins in [0, 1]: sum_b (|B_b|/N) * |acc(B_b) - conf(B_b)| (Denominator: N=448).",
      "Coverage": "N_decisive / N_total. Proportion of samples where model makes a definitive LIKELY_REAL or LIKELY_FAKE decision (Denominator: N_total=448).",
      "Inconclusive Rate": "N_inconclusive / N_total = 1 - Coverage. Proportion of samples where model abstains (Denominator: N_total=448).",
      "Decisive Accuracy": "(TP + TN) / (TP + TN + FP + FN). Classification accuracy evaluated strictly on decisive predictions (Denominator: N_decisive). Inconclusive cases are excluded.",
      "Decisive Fake Recall": "TP / (TP + FN). Sensitivity on fake images among decisive predictions (Denominator: Decisive Fake = TP + FN). Inconclusive fake images are excluded from this denominator.",
      "Decisive Real Specificity": "TN / (TN + FP). Specificity on real images among decisive predictions (Denominator: Decisive Real = TN + FP). Inconclusive real images are excluded from this denominator.",
      "Decisive Precision": "TP / (TP + FP). Proportion of decisive fake alarms that are truly fake (Denominator: Decisive Predicted Fake = TP + FP).",
      "Decisive F1": "2 * (Precision * Recall) / (Precision + Recall). Harmonic mean of decisive precision and recall.",
      "False Positive Rate (FPR)": "FP / (TN + FP). Decisive real images incorrectly classified as fake (Denominator: Decisive Real = TN + FP).",
      "False Negative Rate (FNR)": "FN / (TP + FN). Decisive fake images incorrectly classified as real (Denominator: Decisive Fake = TP + FN).",
      "Selective Error Rate": "(FP + FN) / (TP + TN + FP + FN) = 1 - Decisive Accuracy (Denominator: N_decisive).",
      "Binary Accuracy": "(TP_bin + TN_bin) / N_total. Forced-choice classification accuracy across all 448 samples at decision threshold tau with zero abstentions (Denominator: N_total=448)."
    }
  },
